        "autoscan": true,
        "custom": {
            "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
        }
    },
    "pages": [
        {
            "path": "pages/index/index",
            "style": {
                "navigationBarTitleText": "小肚兜AI",
                "enablePullDownRefresh": true
            }
        },
        {
            "path": "pages/auth/wx-login",
            "style": {
                "navigationBarTitleText": "登录",
